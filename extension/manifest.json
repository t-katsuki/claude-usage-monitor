{
  "manifest_version": 3,
  "name": "Claude Usage Monitor",
  "version": "0.1.1",
  "description": "Claude.ai サブスクリプションの利用枠を一目で確認",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://claude.ai/*"
  ]
}
